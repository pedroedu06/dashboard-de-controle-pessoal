# Copie para .env e preencha. O .env NUNCA vai para o Git.

# Banco do app (Supabase). Use a string do "Session pooler" (porta 5432):
# Supabase > Project > botão "Connect" > aba "Connection String" > Method: Session pooler.
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Banco dos testes de integração (Postgres no Docker, ver docker-compose.yml).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54329/dashboard_test?sslmode=disable
